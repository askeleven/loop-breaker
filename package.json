{
  "name": "@askeleven/loop-breaker",
  "version": "0.1.1",
  "mcpName": "io.github.askeleven/loop-breaker",
  "description": "Stop your agent replying to an autoresponder, a bounce, or another bot. Checks a thread before every reply for the signs of a loop, on any channel, with an optional ledger across threads. CLI, library, and MCP server. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "AskEleven",
  "homepage": "https://github.com/askeleven/loop-breaker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askeleven/loop-breaker.git"
  },
  "bugs": {
    "url": "https://github.com/askeleven/loop-breaker/issues"
  },
  "keywords": [
    "mail-loop",
    "autoresponder",
    "out-of-office",
    "bounce",
    "rfc3834",
    "auto-submitted",
    "email",
    "sms",
    "mcp",
    "mcp-server",
    "ai-agents"
  ],
  "bin": {
    "loop-breaker": "bin/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types && npm test"
  },
  "types": "types/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
