{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.askeleven/loop-breaker",
  "title": "Loop Breaker",
  "description": "Stops an agent replying to autoresponders, bounces or other bots.",
  "repository": {
    "url": "https://github.com/askeleven/loop-breaker",
    "source": "github"
  },
  "websiteUrl": "https://github.com/askeleven/loop-breaker",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@askeleven/loop-breaker",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--ledger",
          "description": "Optional JSONL ledger to track loops across threads",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
